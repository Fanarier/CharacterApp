<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Было false: тогда AssemblyVersion не генерируется и всегда равен 1.0.0.0,
         из-за чего проверка обновлений предлагала один и тот же релиз бесконечно.
         В AssemblyInfo.cs лежит только ThemeInfo, конфликта атрибутов нет. -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationIcon>Images\EspiresGames.ico</ApplicationIcon>

    <!-- ЕДИНСТВЕННОЕ место, где живёт версия.
         Бампать вместе с git-тегом: <Version>1.1.0</Version> ↔ tag v1.1.0 -->
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>Espires Games — Character Sheet</Product>
  </PropertyGroup>

