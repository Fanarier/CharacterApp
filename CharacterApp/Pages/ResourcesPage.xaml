<Page x:Class="CharacterApp.Pages.ResourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ресурсы">

    <Page.Resources>
        <!-- Death save checkbox — success (green) -->
        <Style x:Key="DsSuccess" TargetType="CheckBox">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="2">
                            <TextBlock x:Name="Mark" Text="✓" FontSize="13" FontWeight="Bold"
                                       Foreground="#50C878"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd"   Property="BorderBrush" Value="#50C878"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Death save checkbox — failure (red) -->
        <Style x:Key="DsFail" TargetType="CheckBox">
            <Setter Property="Margin" Value="4,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Bd" Width="26" Height="26" CornerRadius="13"
                                Background="{DynamicResource Surface2Brush}"
                                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="2">
                            <TextBlock x:Name="Mark" Text="✕" FontSize="13" FontWeight="Bold"
                                       Foreground="#F07070"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Bd"   Property="BorderBrush" Value="#F07070"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Padding="20,12" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔔" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Ресурсы" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="BtnRestoreAll_Click" Height="34" Padding="14,0" MinHeight="0"
                            Margin="0,0,8,0" VerticalContentAlignment="Center"
                            ToolTip="Восстановить все ресурсы до максимума">
                        <TextBlock><Run Text="🔄 "/><Run Text="Восстановить всё"/></TextBlock>
                    </Button>
                    <Button Click="BtnAddResource_Click" Height="34" Padding="14,0" MinHeight="0"
                            VerticalContentAlignment="Center">
                        <TextBlock><Run Text="＋ "/><Run Text="Добавить ресурс"/></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ CONTENT ══ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,14,16,24">

                <!-- ─ HP + DEATH SAVES ─ -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" MinWidth="320"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*" MinWidth="190"/>
                    </Grid.ColumnDefinitions>

                    <!-- HP CARD -->
                    <Border Grid.Column="0" Padding="18,16" CornerRadius="14"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <TextBlock Text="❤" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Хиты" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Three HP inputs (direct typing) -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Current HP -->
                                <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                    <TextBlock Text="ТЕКУЩИЕ" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbHpCurrent" Text="0"
                                             FontSize="38" FontWeight="Bold" Foreground="#F07070"
                                             Background="Transparent" BorderThickness="0"
                                             TextAlignment="Center" MinWidth="80"
                                             LostFocus="HpBox_LostFocus" KeyDown="HpBox_KeyDown"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="/" FontSize="28" FontWeight="Bold"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Bottom" Margin="8,0,8,4"/>

                                <!-- Max HP -->
                                <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                    <TextBlock Text="МАКСИМУМ" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbHpMax" Text="0"
                                             FontSize="38" FontWeight="Bold"
                                             Foreground="{DynamicResource TextBrush}"
                                             Background="Transparent" BorderThickness="0"
                                             TextAlignment="Center" MinWidth="80"
                                             LostFocus="HpBox_LostFocus" KeyDown="HpBox_KeyDown"/>
                                </StackPanel>

                                <TextBlock Grid.Column="3" Text="+" FontSize="22"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Bottom" Margin="6,0,6,6"/>

                                <!-- Temp HP -->
                                <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                                    <TextBlock Text="ВРЕМЕННЫЕ" FontSize="9" FontWeight="Bold"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TbHpTemp" Text="0"
                                             FontSize="38" FontWeight="Bold" Foreground="#70B0F0"
                                             Background="Transparent" BorderThickness="0"
                                             TextAlignment="Center" MinWidth="80"
                                             LostFocus="HpBox_LostFocus" KeyDown="HpBox_KeyDown"/>
                                </StackPanel>
                            </Grid>

                            <!-- HP Bar -->
                            <Border x:Name="HpBarTrack" Height="10" CornerRadius="5" Margin="0,0,0,12"
                                    Background="{DynamicResource Surface2Brush}">
                                <Border x:Name="HpFill" CornerRadius="5" HorizontalAlignment="Left" Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#50C850" Offset="0"/>
                                            <GradientStop Color="#30A830" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>

                            <!-- Quick change row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- −1 / +1 quick -->
                                <Button Grid.Column="0" Content="−" Click="BtnHpMinus_Click"
                                        Width="32" Height="32" MinHeight="0" Padding="0"
                                        FontSize="16" FontWeight="Bold" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="＋" Click="BtnHpPlus_Click"
                                        Width="32" Height="32" MinHeight="0" Padding="0"
                                        FontSize="16" FontWeight="Bold" Margin="0,0,10,0"/>

                                <!-- Amount input -->
                                <TextBox Grid.Column="2" x:Name="TbChangeAmount"
                                         Height="32" FontSize="14" FontWeight="Bold"
                                         TextAlignment="Center"
                                         Background="{DynamicResource Surface2Brush}"
                                         BorderBrush="{DynamicResource BorderMedBrush}"
                                         BorderThickness="1" Padding="4"
                                         KeyDown="TbChangeAmount_KeyDown"/>

                                <!-- Heal / Damage -->
                                <ComboBox Grid.Column="3" x:Name="CbChangeType"
                                          Height="32" Width="100" SelectedIndex="0"
                                          Margin="4,0" FontSize="12">
                                    <ComboBoxItem Content="❤ Лечение"/>
                                    <ComboBoxItem Content="⚔ Урон"/>
                                </ComboBox>

                                <Button Grid.Column="4" Content="Применить" Height="32"
                                        MinHeight="0" Padding="12,0"
                                        Click="BtnApplyChange_Click"/>

                                <Button Grid.Column="5" Content="❤ Полное исцеление"
                                        Height="32" MinHeight="0" Padding="10,0" Margin="6,0,0,0"
                                        Click="BtnFullHeal_Click"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- DEATH SAVES CARD -->
                    <Border Grid.Column="2" Padding="16" CornerRadius="14"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Color="#000" Opacity="0.2"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="☠ Спасброски от смерти" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,16"/>

                            <TextBlock Text="УСПЕХИ" FontSize="9" FontWeight="Bold"
                                       Foreground="#50C878" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <CheckBox x:Name="DsS1" Style="{StaticResource DsSuccess}"/>
                                <CheckBox x:Name="DsS2" Style="{StaticResource DsSuccess}"/>
                                <CheckBox x:Name="DsS3" Style="{StaticResource DsSuccess}"/>
                            </StackPanel>

                            <TextBlock Text="ПРОВАЛЫ" FontSize="9" FontWeight="Bold"
                                       Foreground="#F07070" Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                                <CheckBox x:Name="DsF1" Style="{StaticResource DsFail}"/>
                                <CheckBox x:Name="DsF2" Style="{StaticResource DsFail}"/>
                                <CheckBox x:Name="DsF3" Style="{StaticResource DsFail}"/>
                            </StackPanel>

                            <Button Content="🔄 Сбросить" Click="BtnResetDeathSaves_Click"
                                    Padding="10,6" MinHeight="0" HorizontalAlignment="Left"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- ─ RESOURCES HEADER ─ -->
                <Grid Margin="0,4,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ресурсы персонажа" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <Border Grid.Column="1" Height="1" Margin="12,0"
                            Background="{DynamicResource BorderMedBrush}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="TbResCount" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </Grid>

                <!-- Resource cards container -->
                <StackPanel x:Name="ResourceList"/>

                <!-- Empty hint -->
                <Border x:Name="EmptyHint" Padding="24,40" CornerRadius="12" Margin="0,4,0,0"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="🎲" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="Нет пользовательских ресурсов"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380" Margin="0,0,0,6">
                            <Run Text="Добавьте хвосты кицунэ (⭕ Кружки), слоты заклинаний (🟫 Ячейки),"/>
                            <LineBreak/>
                            <Run Text="патроны (🟫 Ячейки), Ki (⭕ Кружки) или любой числовой ресурс (🔢 Числа)"/>
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="340" Margin="0,0,0,18"
                                   Text="ЛКМ по кружку/ячейке — отметить; ПКМ — снять одну отметку"/>
                        <Button Content="＋ Добавить первый ресурс" Click="BtnAddResource_Click"
                                HorizontalAlignment="Center" Padding="16,8" MinHeight="0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
