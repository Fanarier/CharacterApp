<Page x:Class="CharacterApp.Pages.ResourcesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Ресурсы">
    <Page.Resources>
        <Style x:Key="ResourceCounterBtn" TargetType="Button">
            <Setter Property="Width"  Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentLightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentGradientV}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20,16,20,14">
            <TextBlock Text="🔔  Ресурсы" FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
            <Button Content="＋ Добавить ресурс" Click="AddResource_Click"
                    Margin="20,0,0,0" Padding="10,6" VerticalAlignment="Center"/>
            <Button Content="Сбросить всё" Click="ResetAll_Click"
                    Margin="8,0,0,0" Padding="10,6" VerticalAlignment="Center"
                    Foreground="#FF8080"/>
        </StackPanel>

        <!-- Resource cards -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ResourcesStack" Margin="20,0,20,20">

                <!-- HP Tracker (built-in, always first) -->
                <Border Margin="0,0,0,12" Padding="16,14" CornerRadius="12"
                        Background="{DynamicResource SurfaceBrush}"
                        BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="❤  Хиты" FontSize="15" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="−" Tag="HpCurrent-" Click="HpBtn_Click"
                                        Style="{StaticResource ResourceCounterBtn}"/>
                                <StackPanel Margin="8,0">
                                    <TextBlock Text="Текущие" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TbHpCurrent" Text="0"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="#F07070"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="＋" Tag="HpCurrent+" Click="HpBtn_Click"
                                        Style="{StaticResource ResourceCounterBtn}"/>
                                <TextBlock Text=" / " FontSize="24"
                                           Foreground="{DynamicResource TextDimBrush}"
                                           VerticalAlignment="Center" Margin="8,0"/>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Макс" FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TbHpMax" Text="0"
                                               FontSize="28" FontWeight="Bold"
                                               Foreground="{DynamicResource TextBrush}"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="−" Tag="HpMax-" Click="HpBtn_Click"
                                        Style="{StaticResource ResourceCounterBtn}"/>
                                <Button Content="＋" Tag="HpMax+" Click="HpBtn_Click"
                                        Style="{StaticResource ResourceCounterBtn}"/>
                            </StackPanel>
                            <!-- HP bar -->
                            <Border Height="8" CornerRadius="4" Margin="0,10,0,0"
                                    Background="{DynamicResource Surface2Brush}">
                                <Border x:Name="HpBar" CornerRadius="4" HorizontalAlignment="Left"
                                        Width="0">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#F07070" Offset="0"/>
                                            <GradientStop Color="#E03060" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                        </StackPanel>
                        <Button Grid.Column="1" Content="⟳ Полное\nисцеление"
                                Click="FullHeal_Click" VerticalAlignment="Center"
                                Margin="16,0,0,0" Padding="10,8"/>
                    </Grid>
                </Border>

                <!-- Custom resources (injected from code) -->
                <ItemsControl x:Name="CustomResourcesList"/>

                <!-- Empty hint -->
                <TextBlock x:Name="TbEmptyHint"
                           Text="Нажмите «＋ Добавить ресурс» чтобы добавить слоты заклинаний, очки Ki, Superiority Dice и т.д."
                           FontSize="13" Foreground="{DynamicResource TextDimBrush}"
                           TextWrapping="Wrap" Margin="0,16,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center"
                           MaxWidth="400"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
