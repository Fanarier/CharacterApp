<Page x:Class="CharacterApp.Pages.PageDetails"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="{DynamicResource DetailsPageTitle}">
    <ScrollViewer Width="Auto">
        <StackPanel Margin="20">
            <GroupBox Header="{DynamicResource LblBackstory}" Margin="5" Padding="10">
                <TextBox x:Name="BackstoryTextBox"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="100" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Header="{DynamicResource LblWorldview}" Margin="5" Padding="10">
                <TextBox x:Name="WorldviewTextBox"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="60" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Header="{DynamicResource LblPhysique}" Margin="5" Padding="10">
                <UniformGrid Columns="2" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblHeightWeight}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="HeightWeightTextBox" MinWidth="120" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblBodySize}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="BodySizeTextBox" MinWidth="120" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblAge}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="AgeTextBox" MinWidth="60" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>
            <GroupBox Header="{DynamicResource LblAppearance}" Margin="5" Padding="10">
                <TextBox x:Name="AppearanceTextBox"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Height="60" VerticalScrollBarVisibility="Auto"/>
            </GroupBox>

            <GroupBox Header="{DynamicResource LblStartBonuses}" Margin="5" Padding="10">
                <UniformGrid Columns="1" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblStartBonus1}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="StartBonus1TextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblStartBonus2}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="StartBonus2TextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblStartBonus3}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="StartBonus3TextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="{DynamicResource LblProgress}" Margin="5" Padding="10">
                <UniformGrid Columns="2" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblLevel}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="LevelTextBox" MinWidth="120" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblExperience}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="ExperienceTextBox" MinWidth="120" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="{DynamicResource LblStates}" Margin="5" Padding="10">
                <UniformGrid Columns="1" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblAwakening}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="AwakeningTextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblBuff}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="BuffTextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{DynamicResource LblDebuff}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="DebuffTextBox" MinWidth="200" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Page>
