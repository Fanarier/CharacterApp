<Page x:Class="CharacterApp.Pages.StatsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CharacterApp.Controls"
      Title="Характеристики">


  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="12,8">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Left: Сила, Телосложение, Интеллект, Харизма -->
      <StackPanel Grid.Column="0">

        <!-- ═══ СИЛА ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Сила header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Сила" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="StrBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Str"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="StrMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="StrSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="StrSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Атлетика -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Атлетика" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AthTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Ath"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AthTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="AthProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
          </Grid>
        </Border>

        <!-- ═══ ТЕЛОСЛОЖЕНИЕ ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Телосложение header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Телосложение" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ConBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Con"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ConMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="ConSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="ConSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Выдержка/Здоровье -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Выдержка/Здоровье" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="EndTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="End"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="EndTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="EndProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
          </Grid>
        </Border>

        <!-- ═══ ИНТЕЛЛЕКТ ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Интеллект header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Интеллект" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="IntBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Int"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="IntMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="IntSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="IntSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Анализ/Исследование -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Анализ/Исследование" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AnaTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Ana"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AnaTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="AnaProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- История/Память -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="История/Память" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="HisTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="His"/>
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="HisTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="2" Grid.Column="4" x:Name="HisProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Магия/Мистика -->
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Магия/Мистика" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="MagTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Mag"/>
      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="MagTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="3" Grid.Column="4" x:Name="MagProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Природа/Фауна -->
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Природа/Фауна" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="4" Grid.Column="1" x:Name="NatTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Nat"/>
      <TextBlock Grid.Row="4" Grid.Column="2" x:Name="NatTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="4" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="4" Grid.Column="4" x:Name="NatProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Религия/Оккультизм -->
      <TextBlock Grid.Row="5" Grid.Column="0" Text="Религия/Оккультизм" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="5" Grid.Column="1" x:Name="RelTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Rel"/>
      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="RelTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="5" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="5" Grid.Column="4" x:Name="RelProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Технология/Наука -->
      <TextBlock Grid.Row="6" Grid.Column="0" Text="Технология/Наука" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="6" Grid.Column="1" x:Name="TecTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Tec"/>
      <TextBlock Grid.Row="6" Grid.Column="2" x:Name="TecTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="6" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="6" Grid.Column="4" x:Name="TecProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
          </Grid>
        </Border>

        <!-- ═══ ХАРИЗМА ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Харизма header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Харизма" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="ChaBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Cha"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="ChaMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="ChaSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="ChaSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Выступление/Лидер -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Выступление/Лидер" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="PrfTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Prf"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="PrfTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="PrfProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Устрашение -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Устрашение" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="ItmTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Itm"/>
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="ItmTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="2" Grid.Column="4" x:Name="ItmProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Обман -->
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Обман" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="DecTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Dec"/>
      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="DecTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="3" Grid.Column="4" x:Name="DecProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Очарование -->
      <TextBlock Grid.Row="4" Grid.Column="0" Text="Очарование" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="4" Grid.Column="1" x:Name="ChrTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Chr"/>
      <TextBlock Grid.Row="4" Grid.Column="2" x:Name="ChrTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="4" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="4" Grid.Column="4" x:Name="ChrProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Убеждение -->
      <TextBlock Grid.Row="5" Grid.Column="0" Text="Убеждение" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="5" Grid.Column="1" x:Name="PrsTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Prs"/>
      <TextBlock Grid.Row="5" Grid.Column="2" x:Name="PrsTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="5" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="5" Grid.Column="4" x:Name="PrsProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
          </Grid>
        </Border>
      </StackPanel>

      <!-- Right: Ловкость, Мудрость -->
      <StackPanel Grid.Column="2">

        <!-- ═══ ЛОВКОСТЬ ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Ловкость header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Ловкость" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="DexBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Dex"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="DexMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="DexSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="DexSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Акробатика -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Акробатика" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AcrTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Acr"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AcrTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="AcrProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Ловкость рук -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Ловкость рук" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="2" Grid.Column="1" x:Name="SlhTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Slh"/>
      <TextBlock Grid.Row="2" Grid.Column="2" x:Name="SlhTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="2" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="2" Grid.Column="4" x:Name="SlhProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Скрытность -->
      <TextBlock Grid.Row="3" Grid.Column="0" Text="Скрытность" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="3" Grid.Column="1" x:Name="StlTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Stl"/>
      <TextBlock Grid.Row="3" Grid.Column="2" x:Name="StlTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="3" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="3" Grid.Column="4" x:Name="StlProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
          </Grid>
        </Border>

        <!-- ═══ МУДРОСТЬ ═══ -->
        <Border Style="{DynamicResource AttrBlockStyle}" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="130"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="44"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="82"/>
              <ColumnDefinition Width="44"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
      <RowDefinition Height="36"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
      <RowDefinition Height="28"/>
            </Grid.RowDefinitions>
      <!-- ─── Мудрость header ─── -->
      <Border Grid.Row="0" Grid.ColumnSpan="6" Background="{DynamicResource AccentBrush}" Opacity="0.15" CornerRadius="5,5,0,0"/>
      <Rectangle Grid.Row="0" Grid.ColumnSpan="6" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource AccentBrush}" Opacity="0.4"/>
      <TextBlock Grid.Row="0" Grid.Column="0" Text="Мудрость" Style="{DynamicResource AttrNameStyle}"/>
      <TextBox   Grid.Row="0" Grid.Column="1" x:Name="WisBase"      Style="{DynamicResource StatBoxStyle}" TextChanged="AttrBase_Changed" Tag="Wis"/>
      <TextBlock Grid.Row="0" Grid.Column="2" x:Name="WisMod"       Style="{DynamicResource StatValStyle}"  Text="0"/>
      <TextBlock Grid.Row="0" Grid.Column="3" Text="Спасбросок"        Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="0" Grid.Column="4" x:Name="WisSaveDot"
                                   MaxValue="1" HorizontalAlignment="Left" Height="28" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <TextBlock Grid.Row="0" Grid.Column="5" x:Name="WisSaveTotal" Style="{DynamicResource StatValStyle}" Text="0" FontWeight="Bold"/>
      <!-- Внимание -->
      <TextBlock Grid.Row="1" Grid.Column="0" Text="Внимание" Style="{DynamicResource SkillNameStyle}"/>
      <TextBox   Grid.Row="1" Grid.Column="1" x:Name="AttTrain" Style="{DynamicResource StatBoxStyle}" Text="0" TextChanged="Skill_Changed" Tag="Att"/>
      <TextBlock Grid.Row="1" Grid.Column="2" x:Name="AttTotal" Style="{DynamicResource StatValStyle}" Text="0"/>
      <TextBlock Grid.Row="1" Grid.Column="3" Text="Владение"    Style="{DynamicResource LabelStyle}"/>
      <controls:IconRatingControl Grid.Row="1" Grid.Column="4" x:Name="AttProf"
                                   MaxValue="3" HorizontalAlignment="Left" Height="26" VerticalAlignment="Center"
                                   ActiveIcon="{DynamicResource IconDiamondActive}" InactiveIcon="{DynamicResource IconDiamondInactive}"/>
      <!-- Выживание -->
      <TextBlock Grid.Row="2" Grid.Column="0" Text="Выживание" Style="{DynamicResource SkillNameStyle}"/>
