<Page x:Class="CharacterApp.Pages.InventoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Инвентарь">

    <Page.Resources>
        <!-- Wallet coin border -->
        <Style x:Key="CoinBox" TargetType="Border">
            <Setter Property="CornerRadius"    Value="10"/>
            <Setter Property="Padding"         Value="10,5"/>
            <Setter Property="Background"      Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush"     Value="{DynamicResource BorderMedBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinWidth"        Value="100"/>
        </Style>
    </Page.Resources>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══ HEADER ══ -->
        <Border Grid.Row="0" Padding="20,13" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎒" FontSize="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Инвентарь" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TbItemCount" FontSize="12" Margin="10,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <ComboBox x:Name="CbRarityFilter" Width="130" Height="32" Margin="0,0,8,0"
                              SelectionChanged="RarityFilter_Changed"/>
                    <TextBox x:Name="TbSearch" Width="190" Height="32" Margin="0,0,8,0"
                             Tag="Поиск…" TextChanged="Search_Changed"/>
                    <Button Height="32" Padding="14,0" MinHeight="0" Click="AddItem_Click">
                        <TextBlock><Run Text="＋  "/><Run Text="Добавить предмет"/></TextBlock>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ WALLET ══ -->
        <Border Grid.Row="1" Padding="20,9" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="👛  Кошелёк:" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center" Margin="0,0,14,0"/>
                <!-- Gold -->
                <Border Style="{StaticResource CoinBox}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🟡" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TbGold" Text="0" Width="58" FontSize="15" FontWeight="Bold"
                                 Foreground="#FFD700" Background="Transparent" BorderThickness="0"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 TextChanged="Wallet_Changed"/>
                        <TextBlock Text="зм" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Silver -->
                <Border Style="{StaticResource CoinBox}" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚪" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TbSilver" Text="0" Width="58" FontSize="15" FontWeight="Bold"
                                 Foreground="#C8C8D0" Background="Transparent" BorderThickness="0"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 TextChanged="Wallet_Changed"/>
                        <TextBlock Text="см" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </Border>
                <!-- Copper -->
                <Border Style="{StaticResource CoinBox}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🟤" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="TbCopper" Text="0" Width="58" FontSize="15" FontWeight="Bold"
                                 Foreground="#CD7F32" Background="Transparent" BorderThickness="0"
                                 TextAlignment="Center" VerticalAlignment="Center"
                                 TextChanged="Wallet_Changed"/>
                        <TextBlock Text="мм" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="3,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- ══ CONTENT ══ -->
        <Grid Grid.Row="2" Margin="14,12,14,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="310"/>
            </Grid.ColumnDefinitions>

            <!-- ── Item list ── -->
            <Border Grid.Column="0" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Column headers -->
                    <Border Grid.Row="0" Padding="14,8" CornerRadius="12,12,0,0"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="130"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="56"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="ФОТО"     FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBlock Text="НАЗВАНИЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="1" Margin="8,0,0,0"/>
                            <TextBlock Text="ОПИСАНИЕ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="2" Margin="8,0,0,0"/>
                            <TextBlock Text="РЕДКОСТЬ" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="3" Margin="8,0,0,0"/>
                            <TextBlock Text="КОЛ-ВО"  FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="4" HorizontalAlignment="Center"/>
                            <TextBlock Text="НАДЕТ"   FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Grid.Column="5" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="ItemsList"/>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ── Detail panel ── -->
            <Border Grid.Column="2" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                  <StackPanel>
                    <!-- Image area -->
                    <Border x:Name="DetailImageBorder" MaxHeight="220" CornerRadius="12,12,0,0"
                            Background="{DynamicResource Surface2Brush}" ClipToBounds="True">
                        <Grid>
                            <!-- Placeholder -->
                            <StackPanel x:Name="DetailImagePlaceholder"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Margin="0,32,0,32">
                                <TextBlock Text="🖼" FontSize="44" HorizontalAlignment="Center"/>
                                <TextBlock Text="Нет изображения" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                            <!-- Actual image — Uniform so it never crops -->
                            <Image x:Name="DetailImage" Stretch="Uniform"
                                   MaxHeight="220" Visibility="Collapsed"/>
                            <!-- Image overlay buttons -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                                        HorizontalAlignment="Right" Margin="6">
                                <Button x:Name="BtnChangeImg" Content="📷" Width="30" Height="30"
                                        MinHeight="0" Padding="0" FontSize="14" Margin="0,0,4,0"
                                        Click="ChangeImage_Click" ToolTip="Загрузить изображение"/>
                                <Button x:Name="BtnViewImg" Content="🔍" Width="30" Height="30"
                                        MinHeight="0" Padding="0" FontSize="14" Margin="0,0,4,0"
                                        Click="ViewImage_Click" Visibility="Collapsed"
                                        ToolTip="Просмотр в полном размере"/>
                                <Button x:Name="BtnRemoveImg" Content="✕" Width="30" Height="30"
                                        MinHeight="0" Padding="0" FontSize="14"
                                        Click="RemoveImage_Click" Visibility="Collapsed"
                                        ToolTip="Удалить изображение"
                                        Foreground="#F07070"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Margin="14,12,14,14">
                        <!-- Name -->
                        <TextBox x:Name="TbDetailName" FontSize="17" FontWeight="Bold"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextBrush}"
                                 TextWrapping="Wrap" Margin="0,0,0,6"
                                 TextChanged="DetailName_Changed"/>

                        <!-- Rarity badge -->
                        <Border x:Name="DetailRarityBorder" CornerRadius="6" Padding="8,3"
                                HorizontalAlignment="Left" Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TbDetailRarity" FontSize="11" FontWeight="Bold"/>
                                <TextBlock x:Name="TbDetailRarityNote" FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Rarity picker -->
                        <TextBlock Text="РЕДКОСТЬ" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <WrapPanel x:Name="RarityPicker" Orientation="Horizontal"
                                   Margin="0,0,0,12"/>

                        <!-- Quantity + Equipped row -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="КОЛ-ВО" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="−" Width="26" Height="26" MinHeight="0" Padding="0"
                                            Click="QtyMinus_Click"/>
                                    <Border Background="{DynamicResource Surface2Brush}"
                                            BorderBrush="{DynamicResource BorderAccentBrush}"
                                            BorderThickness="1" CornerRadius="6"
                                            Margin="4,0" Padding="8,2">
                                        <TextBlock x:Name="TbDetailQty" Text="1" FontSize="16"
                                                   FontWeight="Bold" Foreground="{DynamicResource TextBrush}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <Button Content="＋" Width="26" Height="26" MinHeight="0" Padding="0"
                                            Click="QtyPlus_Click"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="ЭКИПИРОВАН" FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                                <CheckBox x:Name="CbDetailEquipped" Content="Надет"
                                          Checked="Equipped_Changed" Unchecked="Equipped_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Description -->
                        <TextBlock Text="ОПИСАНИЕ" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbDetailDesc" FontSize="12" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="60" MaxHeight="100"
                                 Background="{DynamicResource Surface2Brush}"
                                 BorderBrush="{DynamicResource BorderMedBrush}"
                                 BorderThickness="1" Padding="8,6" Margin="0,0,0,10"
                                 TextChanged="DetailDesc_Changed"/>

                        <!-- Notes -->
                        <TextBlock Text="ЗАМЕТКИ" FontSize="9" FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TbDetailNotes" FontSize="11" AcceptsReturn="True"
                                 TextWrapping="Wrap" MinHeight="50" MaxHeight="80"
                                 Background="{DynamicResource Surface2Brush}"
                                 BorderBrush="{DynamicResource BorderMedBrush}"
                                 BorderThickness="1" Padding="8,6" Margin="0,0,0,12"
                                 TextChanged="DetailNotes_Changed"/>

                        <!-- Actions -->
                        <StackPanel Orientation="Horizontal">
                            <Button Content="🗑  Удалить" Height="32" Padding="12,0" MinHeight="0"
                                    Foreground="#F07070" Click="DeleteItem_Click" Margin="0,0,6,0"/>
                        </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Page>
