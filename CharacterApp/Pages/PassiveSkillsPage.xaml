<Page x:Class="CharacterApp.Pages.PassiveSkillsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:CharacterApp.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="{DynamicResource PassiveSkillsHeader}">

    <Page.Resources>
        <x:Array Type="{x:Type sys:String}" x:Key="Categories">
            <sys:String>Классовый (К)</sys:String>
            <sys:String>Расовый (P)</sys:String>
        </x:Array>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="12">
            <!-- 0 заголовок, 1 поиск, 2 таблица, 3 кнопки.
                 Раньше строк было три, а кнопки лежали в Grid.Row="3":
                 несуществующая строка сваливает элемент в последнюю, поэтому
                 кнопки наезжали на таблицу, а поиск растягивался на всю высоту -->
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource PassiveSkillsHeader}"
                       FontSize="18" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="4"/>

            <ContentControl x:Name="SearchBarHost" Grid.Row="1" Margin="0,0,0,4"/>

        <DataGrid x:Name="SkillsGrid"
                      Grid.Row="2"
                      Style="{StaticResource SkillsGridStyle}"
                      RowStyle="{StaticResource SkillsRowStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      ItemsSource="{Binding Skills}"
                      Margin="0,8,0,8"
                      Background="Transparent"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      IsReadOnly="False">

                <DataGrid.Columns>
                    <!-- Столбец 1: название -->
                    <DataGridTemplateColumn Header="Название" Width="200" SortMemberPath="SkillName">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SkillName}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding SkillName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CellTextBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Столбец 2: категория -->
                    <DataGridTemplateColumn Header="Категория" Width="180" SortMemberPath="CategoryDisplay">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CategoryDisplay}"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{StaticResource Categories}"
                                          SelectedIndex="{Binding CategoryIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Столбец 3: описание -->
                    <DataGridTemplateColumn Header="Описание" Width="*" MinWidth="240" SortMemberPath="Description">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CellTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Столбец 4: статус (круг/крест) -->
                    <DataGridTemplateColumn Header="●" Width="90" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsActiveSymbol, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Template="{StaticResource StatusToggleTemplate}"
                                              Click="StatusToggle_Click"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="36" Height="36" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ToggleButton IsChecked="{Binding IsActiveSymbol, Mode=TwoWay}"
                                              Template="{StaticResource StatusToggleTemplate}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Width="36" Height="36" Cursor="Hand"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{DynamicResource BtnAddSkill}"    Click="BtnAdd_Click"    Margin="6" Padding="10,6"/>
                <Button Content="{DynamicResource BtnRemoveSkill}" Click="BtnRemove_Click" Margin="6" Padding="10,6"/>
                <Button Content="{DynamicResource BtnResetSkills}" Click="BtnReset_Click"  Margin="6" Padding="10,6"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
