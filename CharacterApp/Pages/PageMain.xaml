<Page x:Class="CharacterApp.Pages.PageMain"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CharacterApp.Controls"
      Title="{DynamicResource AppTitle}">
    <ScrollViewer>
        <StackPanel Margin="20" Orientation="Vertical">

            <GroupBox Header="{DynamicResource GroupPhotoHeader}" Margin="5" Padding="10">
                <StackPanel>
                    <Border BorderThickness="1" BorderBrush="Gray" Height="250" Background="LightGray" Margin="0,0,0,10">
                        <Image x:Name="CharacterImage" Stretch="Uniform"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="BtnAddPhoto" Click="AddPhoto_Click" Margin="5" FontSize="24" Content="{DynamicResource BtnAddPhoto}" Padding="10,5,10,5"/>
                        <Button x:Name="BtnViewPhoto" Click="ViewPhoto_Click" FontSize="24" Content="{DynamicResource BtnViewPhoto}" Margin="5"/>
                        <Button x:Name="BtnDeletePhoto" Click="DeletePhoto_Click" Margin="5" FontSize="24" Content="{DynamicResource BtnDeletePhoto}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource GroupDataHeader}" Margin="5" Padding="10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCharacterName}" MinWidth="60" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="CharacterNameTextBox" MinWidth="120" Margin="5" Height="30" HorizontalAlignment="Stretch"
                                 TextChanged="CharacterName_TextChanged"
                                 ToolTip="Имя персонажа отображается в заголовке окна"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblClass}" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="ClassTextBox" MinWidth="80" Margin="5" Height="30" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblSubclass}" VerticalAlignment="Center" Margin="5"/>
                        <TextBox x:Name="SubclassTextBox" MinWidth="80" Margin="5" Height="25" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource GroupStatsHeader}" Margin="5" Padding="10">
                <UniformGrid Columns="2" Rows="4" Margin="5">
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblHits}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="HitsTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" TextChanged="HitsTextBox_TextChanged" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblDefense}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="DefenseTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" TextChanged="DefenseTextBox_TextChanged" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblEvasion}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="EvasionTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" Height="30" TextChanged="AnyNumericField_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblSuperHits}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="SuperHitsTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" TextChanged="SuperHitsTextBox_TextChanged" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblSpeed}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="SpeedTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" Height="30" TextChanged="AnyNumericField_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCarryCapacity}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="CarryTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" Height="30" TextChanged="AnyNumericField_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblInitiative}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="InitiativeTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" Height="30" TextChanged="AnyNumericField_TextChanged"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblMastery}" MinWidth="100" VerticalAlignment="Center"/>
                        <TextBox x:Name="MasteryTextBox" PreviewTextInput="NumericOnly_PreviewTextInput" MinWidth="60" HorizontalAlignment="Stretch" TextChanged="MasteryTextBox_TextChanged" Height="30"/>
                    </StackPanel>
                </UniformGrid>
            </GroupBox>

            <GroupBox Header="{DynamicResource GroupRatingHeader}" Margin="5" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblExhaustion}" MinWidth="150" VerticalAlignment="Center"/>
                        <controls:IconRatingControl x:Name="ExhaustionControl" MaxValue="5" Width="150"     ActiveIcon="{DynamicResource IconExhaustionActive}" InactiveIcon="{DynamicResource IconExhaustionInactive}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblDeathSaves}" MinWidth="150" VerticalAlignment="Center"/>
                        <controls:IconRatingControl x:Name="DeathSavesControl" MaxValue="3" Width="150" ActiveIcon="{DynamicResource IconDeathSavesActive}" InactiveIcon="{DynamicResource IconDeathSavesInactive}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblVision}" MinWidth="150" VerticalAlignment="Center"/>
                        <controls:IconRatingControl x:Name="VisionControl" MaxValue="10" Width="280" ActiveIcon="{DynamicResource IconVisionActive}" InactiveIcon="{DynamicResource IconVisionInactive}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblHearing}" MinWidth="150" VerticalAlignment="Center"/>
                        <controls:IconRatingControl x:Name="HearingControl" MaxValue="10" Width="280" ActiveIcon="{DynamicResource IconHearingActive}" InactiveIcon="{DynamicResource IconHearingInactive}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblAura}" MinWidth="150" VerticalAlignment="Center"/>
                        <controls:IconRatingControl x:Name="AuraControl" MaxValue="10" Width="280" ActiveIcon="{DynamicResource IconAuraActive}" InactiveIcon="{DynamicResource IconAuraInactive}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblMana}" MinWidth="145" VerticalAlignment="Center"/>
                        <TextBox x:Name="ManaTextBox" MinWidth="80" HorizontalAlignment="Stretch" TextChanged="ManaTextBox_TextChanged" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblStamina}" MinWidth="145" VerticalAlignment="Center"/>
                        <TextBox x:Name="StaminaTextBox" MinWidth="80" HorizontalAlignment="Stretch" Height="30" TextChanged="StaminaTextBox_TextChanged"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ══════════════════════════════════════════════════════════════ -->
            <!-- Треугольник развития: Тело — Разум — Дух                     -->
            <!-- ══════════════════════════════════════════════════════════════ -->
            <Border Margin="5,4,5,4" Padding="14,12" CornerRadius="12"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.25"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="🔺  Треугольник развития"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               Margin="0,0,0,10"/>

                    <!-- Поля ввода -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Тело -->
                        <TextBlock Grid.Column="0" Grid.Row="0" Text="⚔  Тело"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Grid.Column="0" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox x:Name="TbBodyDev" Width="54" Height="32" MaxLength="1"
                                     TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                     TextChanged="TriDev_Changed" Tag="Body"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="/8" VerticalAlignment="Center" Margin="4,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Разум -->
                        <TextBlock Grid.Column="1" Grid.Row="0" Text="📖  Разум"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Grid.Column="1" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox x:Name="TbMindDev" Width="54" Height="32" MaxLength="1"
                                     TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                     TextChanged="TriDev_Changed" Tag="Mind"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="/8" VerticalAlignment="Center" Margin="4,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <!-- Дух -->
                        <TextBlock Grid.Column="2" Grid.Row="0" Text="✨  Дух"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentLightBrush}"
                                   HorizontalAlignment="Center" Margin="0,0,0,4"/>
                        <StackPanel Grid.Column="2" Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBox x:Name="TbSpiritDev" Width="54" Height="32" MaxLength="1"
                                     TextAlignment="Center" FontSize="14" FontWeight="Bold"
                                     TextChanged="TriDev_Changed" Tag="Spirit"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="/8" VerticalAlignment="Center" Margin="4,0,0,0"
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- Диаграмма-паутина -->
                    <controls:TriangleChartControl
                        x:Name="TriangleChart"
                        Width="260" Height="240"
                        HorizontalAlignment="Center"
                        MaxValue="8"/>
                </StackPanel>
            </Border>

            <GroupBox Header="{DynamicResource GroupCustomFieldsHeader}" Margin="5" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCustomField1}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomField1Label" MinWidth="80" Margin="2,2,10,2" Height="30" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="CustomField1Value" MinWidth="80" Margin="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCustomField2}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomField2Label" MinWidth="80" Margin="2,2,10,2" Height="30" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="CustomField2Value" MinWidth="80" Margin="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCustomField3}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomField3Label" MinWidth="80" Margin="2,2,10,2" Height="30" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="CustomField3Value" MinWidth="80" Margin="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <TextBlock Text="{DynamicResource LblCustomField4}" MinWidth="120" VerticalAlignment="Center"/>
                        <TextBox x:Name="CustomField4Label" MinWidth="80" Margin="2,2,10,2" Height="30" HorizontalAlignment="Stretch"/>
                        <TextBox x:Name="CustomField4Value" MinWidth="80" Margin="2" HorizontalAlignment="Stretch"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</Page>