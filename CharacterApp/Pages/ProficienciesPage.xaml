<Page x:Class="CharacterApp.Pages.ProficienciesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="clr-namespace:CharacterApp.Controls"
      xmlns:local="clr-namespace:CharacterApp.Pages"
      xmlns:sys="clr-namespace:System;assembly=mscorlib"
      Title="{DynamicResource ProficienciesHeader}">

    <Page.Resources>
        <!-- Типы строки владений -->
        <x:Array Type="{x:Type sys:String}" x:Key="ProficiencyTypes">
            <sys:String>Владение</sys:String>
            <sys:String>Язык</sys:String>
        </x:Array>

        <!-- Стили заголовков таблиц -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontWeight"  Value="Bold"/>
            <Setter Property="Padding"     Value="6,4"/>
        </Style>

        <!-- Стиль фиксированной строки черты -->
        <Style x:Key="TraitLabelStyle" TargetType="TextBlock">
            <Setter Property="FontWeight"        Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground"        Value="{DynamicResource TextBrush}"/>
            <Setter Property="Margin"            Value="6,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12">

            <!-- ══ Черты (фиксированные 3 строки) ════════════════════════════ -->
            <TextBlock Text="{DynamicResource TraitsHeader}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="4,0,4,8"/>

            <Border BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Заголовки -->
                    <Border Grid.Row="0" Grid.ColumnSpan="3"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="3,3,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Черта"       FontWeight="Bold" Foreground="White" Padding="8,6"/>
                            <TextBlock Grid.Column="1" Text="Описание"    FontWeight="Bold" Foreground="White" Padding="6,6"/>
                            <TextBlock Grid.Column="2" Text="✓"           FontWeight="Bold" Foreground="White" Padding="6,6" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Черта 4 уровень -->
                    <Border Grid.Row="1" Grid.ColumnSpan="3" BorderBrush="#18000000" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Черта (4 уровень)"  Style="{StaticResource TraitLabelStyle}" Padding="8,8"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="Trait4Desc"
                               Margin="4,4" Padding="4,4" Background="Transparent"
                               BorderThickness="0" TextChanged="TraitField_Changed"/>
                    <CheckBox  Grid.Row="1" Grid.Column="2" x:Name="Trait4Check"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Checked="TraitField_Changed" Unchecked="TraitField_Changed"/>

                    <!-- Черта 9 уровень -->
                    <Border Grid.Row="2" Grid.ColumnSpan="3" BorderBrush="#18000000" BorderThickness="0,0,0,1"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Черта (9 уровень)"  Style="{StaticResource TraitLabelStyle}" Padding="8,8"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" x:Name="Trait9Desc"
                               Margin="4,4" Padding="4,4" Background="Transparent"
                               BorderThickness="0" TextChanged="TraitField_Changed"/>
                    <CheckBox  Grid.Row="2" Grid.Column="2" x:Name="Trait9Check"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Checked="TraitField_Changed" Unchecked="TraitField_Changed"/>

                    <!-- Черта 18 уровень -->
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Черта (18 уровень)" Style="{StaticResource TraitLabelStyle}" Padding="8,8"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" x:Name="Trait18Desc"
                               Margin="4,4" Padding="4,4" Background="Transparent"
                               BorderThickness="0" TextChanged="TraitField_Changed"/>
                    <CheckBox  Grid.Row="3" Grid.Column="2" x:Name="Trait18Check"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Checked="TraitField_Changed" Unchecked="TraitField_Changed"/>
                </Grid>
            </Border>

            <!-- ══ Черты гуманоидов (до 5, добавляются кнопкой) ═══════════════ -->
            <Grid Margin="4,0,4,8">
                <TextBlock Text="Черты гуманоидов"
                           FontSize="16" FontWeight="Bold"
                           Foreground="{DynamicResource TextBrush}"
                           HorizontalAlignment="Left"/>
                <TextBlock x:Name="TbHumanoidCount"
                           FontSize="12" VerticalAlignment="Center"
                           HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextMutedBrush}"/>
            </Grid>

            <DataGrid x:Name="HumanoidGrid"
                      Style="{StaticResource SkillsGridStyle}"
                      RowStyle="{StaticResource SkillsRowStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      ItemsSource="{Binding HumanoidTraits}"
                      Margin="0,0,0,8"
                      Background="Transparent"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      IsReadOnly="False">
                <DataGrid.Columns>
                    <!-- Название -->
                    <DataGridTemplateColumn Header="Название" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CellTextBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Описание -->
                    <DataGridTemplateColumn Header="Описание" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CellTextBox}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="✓" Width="60" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsAcquired, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,16">
                <Button Content="{DynamicResource BtnAddSkill}"    Click="BtnAddHumanoid_Click"    Margin="6" Padding="10,6"/>
                <Button Content="{DynamicResource BtnRemoveSkill}" Click="BtnRemoveHumanoid_Click" Margin="6" Padding="10,6"/>
            </StackPanel>

            <!-- ══ Владения / Языки (динамическая таблица) ════════════════════ -->
            <TextBlock Text="{DynamicResource ProficienciesTableHeader}"
                       FontSize="16" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}"
                       Margin="4,0,4,8"/>

            <DataGrid x:Name="ProfGrid"
                      Style="{StaticResource SkillsGridStyle}"
                      RowStyle="{StaticResource SkillsRowStyle}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      RowHeaderWidth="0"
                      ItemsSource="{Binding Proficiencies}"
                      Margin="0,0,0,8"
                      Background="Transparent"
                      GridLinesVisibility="Horizontal"
                      SelectionMode="Single"
                      IsReadOnly="False">

                <DataGrid.Columns>
                    <!-- Столбец 1: тип (Владение / Язык) -->
                    <DataGridTemplateColumn Header="Тип" Width="140">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TypeDisplay}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{StaticResource ProficiencyTypes}"
                                          SelectedIndex="{Binding TypeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Background="Transparent"
                                          Foreground="{DynamicResource TextBrush}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Столбец 2: описание -->
                    <DataGridTemplateColumn Header="Описание" Width="*" MinWidth="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Description}"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextBrush}"
                                           VerticalAlignment="Center" Padding="6,4"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                        <DataGridTemplateColumn.CellEditingTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource CellTextBox}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellEditingTemplate>
                    </DataGridTemplateColumn>

                    <!-- Столбец 3: 3 ромбика (уровень владения) -->
                    <DataGridTemplateColumn Header="Уровень" Width="110" IsReadOnly="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <controls:IconRatingControl
                                    Value="{Binding Rating, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    MaxValue="3"
                                    Width="96"
                                    ActiveIcon="{DynamicResource IconDiamondActive}"
                                    InactiveIcon="{DynamicResource IconDiamondInactive}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Кнопки управления -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                <Button Content="{DynamicResource BtnAddSkill}"    Click="BtnAdd_Click"    Margin="6" Padding="10,6"/>
                <Button Content="{DynamicResource BtnRemoveSkill}" Click="BtnRemove_Click" Margin="6" Padding="10,6"/>
                <Button Content="{DynamicResource BtnResetSkills}" Click="BtnReset_Click"  Margin="6" Padding="10,6"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
