<Page x:Class="CharacterApp.Pages.JournalPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Журнал">

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT PANEL: session list -->
        <DockPanel Grid.Column="0" Margin="20,16,8,20">
            <TextBlock DockPanel.Dock="Top" Text="📝  Журнал сессий"
                       FontSize="22" FontWeight="Bold"
                       Foreground="{DynamicResource TextBrush}" Margin="0,0,0,14"/>

            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="＋ Новая запись" Click="NewEntry_Click"
                        Padding="10,6" Margin="0,0,6,0"/>
                <Button Content="🗑" Click="DeleteEntry_Click"
                        Padding="8,6" Margin="0"
                        ToolTip="Удалить выбранную запись"/>
            </StackPanel>

            <ListBox x:Name="LbEntries" DockPanel.Dock="Top"
                     SelectionChanged="LbEntries_SelectionChanged"
                     Background="{DynamicResource SurfaceBrush}"
                     BorderBrush="{DynamicResource BorderMedBrush}"
                     BorderThickness="1">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,4">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource TextBrush}"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding DateStr}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- RIGHT PANEL: editor -->
        <Grid Grid.Column="1" Margin="8,16,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title input -->
            <TextBox x:Name="TbTitle" Grid.Row="0"
                     FontSize="18" FontWeight="SemiBold"
                     Margin="0,0,0,10" Height="40"
                     IsEnabled="False"
                     TextChanged="TbTitle_Changed"/>

            <!-- Tags row -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="📅 " VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock x:Name="TbDate" VerticalAlignment="Center"
                           FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="   🏷 " VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBox x:Name="TbTags" Width="200" Height="26"
                         FontSize="12" Padding="6,2"
                         TextChanged="TbTags_Changed"
                         ToolTip="Теги через запятую"/>
            </StackPanel>

            <!-- Content -->
            <Border Grid.Row="2"
                    BorderBrush="{DynamicResource BorderMedBrush}"
                    BorderThickness="1" CornerRadius="8">
                <TextBox x:Name="TbContent"
                         AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         FontSize="14"
                         TextChanged="TbContent_Changed"
                         Background="{DynamicResource SurfaceBrush}"
                         Foreground="{DynamicResource TextBrush}"
                         BorderThickness="0" Padding="14,12"
                         VerticalContentAlignment="Top"/>
            </Border>

            <!-- Status bar -->
            <StackPanel Grid.Row="3" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <TextBlock x:Name="TbWordCount" Text="0 слов"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock x:Name="TbSaveStatus" Text="✔ Сохранено"
                           FontSize="11" Foreground="{DynamicResource TextDimBrush}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Empty state overlay -->
            <Border x:Name="EmptyOverlay" Grid.Row="0" Grid.RowSpan="4"
                    Background="{DynamicResource WindowBackgroundBrush}"
                    Visibility="Visible">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="📝" FontSize="48" HorizontalAlignment="Center"
                               Opacity="0.3"/>
                    <TextBlock Text="Выберите запись или создайте новую"
                               FontSize="15" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextDimBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
