<UserControl x:Class="CharacterApp.NotificationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="300" Height="Auto" Opacity="0" Margin="0,0,0,8"
             HorizontalAlignment="Right">
    <Border x:Name="Root"
            CornerRadius="8,0,0,8"
            Padding="12,10"
            BorderThickness="1,1,0,1"
            HorizontalAlignment="Right">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="3" Color="#000000" Opacity="0.4"/>
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="IconBlock"
                       DockPanel.Dock="Left"
                       FontSize="17"
                       Margin="0,0,10,0"
                       VerticalAlignment="Center"
                       Foreground="White"/>
            <TextBlock x:Name="MessageBlock"
                       TextWrapping="Wrap"
                       Foreground="White"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       VerticalAlignment="Center"/>
        </DockPanel>
    </Border>
</UserControl>
