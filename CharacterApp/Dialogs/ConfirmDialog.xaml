<Window x:Class="CharacterApp.Dialogs.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="380" Height="170"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="{DynamicResource WindowBackgroundBrush}"
            BorderBrush="{DynamicResource AccentBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid Margin="20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Иконка + сообщение -->
            <DockPanel Grid.Row="0" Margin="0,0,0,16">
                <Border x:Name="IconBorder" DockPanel.Dock="Left"
                        Width="36" Height="36" CornerRadius="18" Margin="0,0,14,0"
                        Background="{DynamicResource AccentBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="IconText" Text="?" FontSize="18" FontWeight="Bold"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock x:Name="MessageText" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextBrush}"
                           FontSize="13" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Кнопки -->
            <StackPanel Grid.Row="2" Orientation="Horizontal"
                        HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button x:Name="BtnYes"   Content="Да"      Width="80" Margin="0,0,8,0" Click="BtnYes_Click" Style="{DynamicResource PrimaryButton}"/>
                <Button x:Name="BtnNo"    Content="Нет"     Width="80" Margin="0,0,8,0" Click="BtnNo_Click"/>
                <Button x:Name="BtnCancel" Content="Отмена" Width="80" Visibility="Collapsed" Click="BtnCancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
