<Window x:Class="CharacterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CharacterApp.Controls"
        xmlns:pages="clr-namespace:CharacterApp.Pages"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CharacterApp"
        Title="Espires Games" Height="800" Width="1000"
        MinHeight="500" MinWidth="1150"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Icon="/Images/EspiresGames.ico">

    <!-- Локальные ресурсы -->
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="White"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#35FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#55FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- KeyBindings registered in code-behind to avoid x:Static designer errors -->

    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome
      CaptionHeight="0"
      ResizeBorderThickness="5"
      GlassFrameThickness="0,-1,0,0"
      UseAeroCaptionButtons="False"
      NonClientFrameEdges="None"
      CornerRadius="0"/>
    </chrome:WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="{DynamicResource AccentGradient}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Grid.Column="0"
                            Margin="10,0,5,0">
                    <!-- Back button -->
                    <Button x:Name="BtnBack"
                            Click="BtnBack_Click"
                            Visibility="Collapsed"
                            ToolTip="Назад"
                            Width="28" Height="22" Margin="0,0,6,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Border Background="#30FFFFFF" CornerRadius="5" Padding="4,2">
                            <TextBlock Text="◀" Foreground="White" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Image Source="/Images/EspiresGames.ico"
                           Width="20" Height="20"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleBarText" Text="{DynamicResource AppTitle}"
                               Foreground="White"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Grid.Column="2" Panel.ZIndex="999" Margin="0,0,10,0">
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Minimize_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Свернуть" Margin="0,0,4,0">
                        <Path Data="M0,5 L10,5" Stroke="White" StrokeThickness="2"/>
                    </Button>
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Maximize_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Развернуть/Восстановить" Margin="0,0,4,0">
                        <Path x:Name="MaximizePath" Data="M0,0 L10,0 L10,10 L0,10 Z" Fill="Transparent" Stroke="White" StrokeThickness="2"/>
                    </Button>
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Close_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Закрыть">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="White" StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" x:Name="Sidebar" Width="250" ClipToBounds="True"
                    Background="{DynamicResource SidebarGradient}">
                <Border BorderBrush="{DynamicResource SidebarSeparatorBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>

                        <!-- TOP: burger + search -->
                        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,4">
                            <Button x:Name="BtnToggleMenu" Width="38" Height="38"
                                    HorizontalAlignment="Left" Click="BtnToggleMenu_Click"
                                    ToolTip="Открыть/закрыть меню"
                                    Margin="4,0,0,6" Background="Transparent" BorderThickness="0">
                                <Grid Width="20" Height="15">
                                    <Rectangle Height="2" VerticalAlignment="Top"    RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                    <Rectangle Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                    <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                </Grid>
                            </Button>

                            <!-- Character tabs -->
                            <Border x:Name="CharacterTabsBorder"
                                    BorderBrush="{DynamicResource BorderAccentBrush}"
                                    BorderThickness="0,0,0,1" Margin="0,0,0,8" Padding="0,0,0,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled"
                                              PanningMode="HorizontalOnly">
                                    <WrapPanel x:Name="CharacterTabsPanel"
                                               Orientation="Horizontal"
                                               Margin="0,0,0,0"/>
                                </ScrollViewer>
                            </Border>

                            <TextBox x:Name="TbMenuSearch" Height="34" Margin="0,0,0,4"
                                     TextChanged="TbMenuSearch_TextChanged" Visibility="Visible"/>
                        </StackPanel>

                        <!-- BOTTOM: dice roller + save/load actions -->
                        <Border DockPanel.Dock="Bottom" x:Name="BottomButtonsPanel" Padding="0,6,0,8"
                                Background="{DynamicResource SidebarBottomGradient}">
                            <Border BorderBrush="{DynamicResource SidebarBottomSeparatorBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Margin="0,4,0,0">
                                    <Button Click="QuickSave_Click"    Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="💾  "/><Run Text="{DynamicResource QuickSaveBtn}"/></TextBlock></Button>
                                    <Button Click="SaveAs_Click"       Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="📁  "/><Run Text="{DynamicResource SaveAsBtn}"/></TextBlock></Button>
                                    <Button Click="LoadJSON_Click"     Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="📂  "/><Run Text="{DynamicResource LoadBtn}"/></TextBlock></Button>
                                    <Button Click="ExportXps_Click"    Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="🖨️  "/><Run Text="Экспорт в PDF"/></TextBlock></Button>
                                    <Button Click="ResetAll_Click"     Style="{DynamicResource SidebarActionButton}" Foreground="#FF7070"><TextBlock><Run Text="🔄  "/><Run Text="{DynamicResource ResetBtn}"/></TextBlock></Button>
                                    <Button Click="CheckUpdates_Click" Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="⬆   "/><Run Text="{DynamicResource CheckUpdatesBtn}"/></TextBlock></Button>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- MAIN NAV -->
                        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MenuStack" Margin="4,0,4,8">
                                <Border Margin="10,2,10,10" Padding="6,8">
                                    <TextBlock Text="{DynamicResource MenuTitle}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource MenuTitleBrush}"/>
                                </Border>
                                <Button Content="{DynamicResource MainPageBtn}"          Click="MainPage_Click"      Tag="builtin:MainPage"      Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource DetailsPageBtn}"       Click="Details_Click"       Tag="builtin:Details"       Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource EquipmentPageBtn}"     Click="Equipment_Click"     Tag="builtin:Equipment"     Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource StatsPageBtn}"         Click="Stats_Click"         Tag="builtin:Stats"         Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource ActiveSkillsPageBtn}"  Click="ActiveSkills_Click"  Tag="builtin:ActiveSkills"  Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource PassiveSkillsPageBtn}" Click="PassiveSkills_Click" Tag="builtin:PassiveSkills" Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource ProficienciesPageBtn}" Click="Proficiencies_Click" Tag="builtin:Proficiencies" Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource AttacksPageBtn}"       Click="Attacks_Click"       Tag="builtin:Attacks"       Style="{DynamicResource SidebarNavButton}"/>
                                <Separator Margin="10,8"/>
                                <Button Content="📝  Журнал сессий"                     Click="Journal_Click"       Tag="builtin:Journal"       Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="🔔  Ресурсы"                           Click="Resources_Click"     Tag="builtin:Resources"     Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="🎲  Кубики"                            Click="Dice_Click"          Tag="builtin:Dice"          Style="{DynamicResource SidebarNavButton}"/>
                                <Button Content="{DynamicResource SettingsPageBtn}"      Click="Settings_Click"      Tag="builtin:Settings"      Style="{DynamicResource SidebarNavButton}"/>
                            </StackPanel>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
            </Border>



            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="10,10,0,10"/>
            

            <StackPanel x:Name="NotificationHost"
            Grid.Column="1"
            IsHitTestVisible="False"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Width="305"
            Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Window>
