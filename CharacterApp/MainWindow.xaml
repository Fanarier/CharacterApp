<Window x:Class="CharacterApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:CharacterApp.Controls"
        xmlns:pages="clr-namespace:CharacterApp.Pages"
        xmlns:chrome="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:CharacterApp"
        Title="Espires Games" Height="800" Width="1000"
        MinHeight="500" MinWidth="1150"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource WindowBackgroundBrush}" Icon="/Images/EspiresGames.ico">

    <!-- Локальные ресурсы -->
    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width"           Value="34"/>
            <Setter Property="Height"          Value="30"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- KeyBindings registered in code-behind to avoid x:Static designer errors -->

    <chrome:WindowChrome.WindowChrome>
        <chrome:WindowChrome
      CaptionHeight="0"
      ResizeBorderThickness="5"
      GlassFrameThickness="0,-1,0,0"
      UseAeroCaptionButtons="False"
      NonClientFrameEdges="None"
      CornerRadius="0"/>
    </chrome:WindowChrome.WindowChrome>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна была залита акцентным градиентом — самая большая цветная
             область на экране, из-за неё акцент терял смысл указателя -->
        <Border Grid.Row="0"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Grid.Column="0"
                            Margin="10,0,5,0">
                    <!-- Back button -->
                    <Button x:Name="BtnBack"
                            Click="BtnBack_Click"
                            Visibility="Collapsed"
                            ToolTip="Назад"
                            Width="28" Height="22" Margin="0,0,6,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="5" Padding="4,2">
                            <TextBlock Text="◀" Foreground="{DynamicResource TextBrush}" FontSize="11"
                                       VerticalAlignment="Center"/>
                        </Border>
                    </Button>
                    <Image Source="/Images/EspiresGames.ico"
                           Width="20" Height="20"
                           VerticalAlignment="Center"/>
                    <TextBlock x:Name="TitleBarText" Text="{DynamicResource AppTitle}"
                               Foreground="{DynamicResource TextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="5,0,0,0"/>
                </StackPanel>
                <Border Grid.Column="1"/>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Grid.Column="2" Panel.ZIndex="999" Margin="0,0,10,0">
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Minimize_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Свернуть" Margin="0,0,4,0">
                        <Path Data="M0,5 L10,5" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"/>
                    </Button>
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Maximize_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Развернуть/Восстановить" Margin="0,0,4,0">
                        <Path x:Name="MaximizePath" Data="M0,0 L10,0 L10,10 L0,10 Z" Fill="Transparent" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"/>
                    </Button>
                    <Button
    chrome:WindowChrome.IsHitTestVisibleInChrome="False"
    Click="Close_Click"
    Style="{DynamicResource TitleBarButtonStyle}"
    ToolTip="Закрыть">
                        <Path Data="M0,0 L10,10 M0,10 L10,0" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="2"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR -->
            <Border Grid.Column="0" x:Name="Sidebar" Width="250" ClipToBounds="True"
                    Background="{DynamicResource SidebarGradient}">
                <Border BorderBrush="{DynamicResource SidebarSeparatorBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>

                        <!-- TOP: burger + search -->
                        <StackPanel x:Name="SidebarTopPanel" DockPanel.Dock="Top" Margin="10,10,10,4">
                            <Button x:Name="BtnToggleMenu" Width="38" Height="38"
                                    HorizontalAlignment="Left" Click="BtnToggleMenu_Click"
                                    ToolTip="Открыть/закрыть меню"
                                    Margin="4,0,0,6" Background="Transparent" BorderThickness="0">
                                <Grid Width="20" Height="15">
                                    <Rectangle Height="2" VerticalAlignment="Top"    RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                    <Rectangle Height="2" VerticalAlignment="Center" RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                    <Rectangle Height="2" VerticalAlignment="Bottom" RadiusX="1" RadiusY="1" Fill="{DynamicResource BurgerLineBrush}"/>
                                </Grid>
                            </Button>

                            <!-- Выбор персонажа. Раньше здесь был ряд табов: при
                                 десятке персонажей он переносился на несколько
                                 строк и съедал половину панели -->
                            <Border x:Name="CharacterTabsBorder" Margin="0,0,0,8">
                                <StackPanel>
                                    <Button x:Name="BtnCharacterSelector"
                                            Click="CharacterSelector_Click"
                                            ToolTip="Выбрать персонажа"
                                            Height="38" Padding="10,0" Margin="0,0,0,4"
                                            HorizontalContentAlignment="Stretch">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <!-- В узкой панели остаётся только этот значок:
                                                 иначе до смены персонажа не добраться -->
                                            <Path x:Name="IconCurrentCharacter" Grid.Column="0"
                                                  Data="{StaticResource IcoIdCard}"
                                                  Width="24" Height="24" Stretch="None"
                                                  Margin="0,0,8,0" VerticalAlignment="Center"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5" Fill="Transparent"/>
                                            <TextBlock x:Name="TbCurrentCharacter" Grid.Column="1"
                                                       Text="Персонаж" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock x:Name="TbSelectorArrow" Grid.Column="2"
                                                       Text="⌄" FontSize="14"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </Button>

                                    <Popup x:Name="CharacterPopup" StaysOpen="False"
                                           Placement="Bottom" PlacementTarget="{Binding ElementName=BtnCharacterSelector}"
                                           AllowsTransparency="True" PopupAnimation="Fade">
                                        <Border Background="{DynamicResource SurfaceBrush}"
                                                BorderBrush="{DynamicResource BorderMedBrush}"
                                                BorderThickness="1" CornerRadius="8"
                                                Padding="4" MinWidth="228">
                                            <StackPanel>
                                                <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                                    <StackPanel x:Name="CharacterListPanel"/>
                                                </ScrollViewer>
                                                <Separator Margin="4,4"/>
                                                <Button Content="＋  Добавить персонажа"
                                                        Click="AddCharacter_Click"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="10,6" Margin="0"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </StackPanel>
                            </Border>

                            <TextBox x:Name="TbMenuSearch" Height="34" Margin="0,0,0,4"
                                     TextChanged="TbMenuSearch_TextChanged" Visibility="Visible"/>
                        </StackPanel>

                        <!-- BOTTOM: dice roller + save/load actions -->
                        <Border DockPanel.Dock="Bottom" x:Name="BottomButtonsPanel" Padding="0,6,0,8"
                                Background="{DynamicResource SidebarBottomGradient}">
                            <Border BorderBrush="{DynamicResource SidebarBottomSeparatorBrush}" BorderThickness="0,1,0,0">
                                <StackPanel Margin="0,4,0,0">
                                    <Button Click="QuickSave_Click"    Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="💾  "/><Run Text="{DynamicResource QuickSaveBtn}"/></TextBlock></Button>
                                    <Button Click="SaveAs_Click"       Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="📁  "/><Run Text="{DynamicResource SaveAsBtn}"/></TextBlock></Button>
                                    <Button Click="LoadJSON_Click"     Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="📂  "/><Run Text="{DynamicResource LoadBtn}"/></TextBlock></Button>
                                    <Button Click="ExportXps_Click"    Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="🖨️  "/><Run Text="Экспорт в PDF"/></TextBlock></Button>
                                    <Button Click="ResetAll_Click"     Style="{DynamicResource SidebarActionButton}" Foreground="#FF7070"><TextBlock><Run Text="🔄  "/><Run Text="{DynamicResource ResetBtn}"/></TextBlock></Button>
                                    <Button Click="CheckUpdates_Click" Style="{DynamicResource SidebarActionButton}"><TextBlock><Run Text="⬆   "/><Run Text="{DynamicResource CheckUpdatesBtn}"/></TextBlock></Button>
                                </StackPanel>
                            </Border>
                        </Border>

                        <!-- MAIN NAV -->
                        <ScrollViewer x:Name="MenuScroll" DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="MenuStack" Margin="4,0,4,8">
                                <Border Margin="10,2,10,10" Padding="6,8">
                                    <TextBlock Text="{DynamicResource MenuTitle}" FontSize="18" FontWeight="Bold"
                                               Foreground="{DynamicResource MenuTitleBrush}"/>
                                </Border>
                                <Button Click="MainPage_Click" Tag="builtin:MainPage" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoHome}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource MainPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Details_Click" Tag="builtin:Details" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoBook}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource DetailsPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Equipment_Click" Tag="builtin:Equipment" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoShield}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource EquipmentPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Inventory_Click" Tag="builtin:Inventory" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoBag}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource NavInventory}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Stats_Click" Tag="builtin:Stats" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoChart}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource StatsPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="ActiveSkills_Click" Tag="builtin:ActiveSkills" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoBolt}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource ActiveSkillsPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="PassiveSkills_Click" Tag="builtin:PassiveSkills" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoStar}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource PassiveSkillsPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Proficiencies_Click" Tag="builtin:Proficiencies" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoBadge}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource ProficienciesPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Attacks_Click" Tag="builtin:Attacks" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoSword}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource AttacksPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Separator Margin="10,8"/>
                                <Button Click="Journal_Click" Tag="builtin:Journal" Style="{DynamicResource SidebarNavButton}"
                                        ToolTip="Журнал сессий">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoNote}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="Журнал сессий" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Resources_Click" Tag="builtin:Resources" Style="{DynamicResource SidebarNavButton}"
                                        ToolTip="Ресурсы">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoBell}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="Ресурсы" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Dice_Click" Tag="builtin:Dice" Style="{DynamicResource SidebarNavButton}"
                                        ToolTip="Кубики">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoDice}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="Кубики" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Click="Settings_Click" Tag="builtin:Settings" Style="{DynamicResource SidebarNavButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="{StaticResource IcoGear}" Width="24" Height="24"
                                              Stretch="None" Margin="0,0,8,0"
                                              VerticalAlignment="Center"
                                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                              StrokeThickness="1.5" Fill="Transparent"/>
                                        <TextBlock Text="{DynamicResource SettingsPageBtn}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>

                    </DockPanel>
                </Border>
            </Border>



            <Frame x:Name="MainFrame" Grid.Column="1" NavigationUIVisibility="Hidden" Margin="10,10,0,10"/>
            

            <StackPanel x:Name="NotificationHost"
            Grid.Column="1"
            IsHitTestVisible="False"
            VerticalAlignment="Top"
            HorizontalAlignment="Right"
            Width="305"
            Margin="0,8,0,0"/>
        </Grid>
    </Grid>
</Window>
