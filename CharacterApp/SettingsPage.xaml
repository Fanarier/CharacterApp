<Page x:Class="CharacterApp.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Настройки">
    <ScrollViewer>
        <ScrollViewer.Background>
            <ImageBrush ImageSource="/Images/Background_1.png"
                Stretch="None"
                AlignmentX="Left"
                AlignmentY="Top"
                Viewport="0,0,1024,1024"
                ViewportUnits="Absolute"
                TileMode="None" Opacity="0.06" ViewboxUnits="RelativeToBoundingBox"/>
        </ScrollViewer.Background>
        <StackPanel Margin="20" Orientation="Vertical">
            <TextBlock Text="Настройки" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" HorizontalAlignment="Center"/>
            <GroupBox Header="Выбор темы" Margin="5" Padding="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                        <TextBlock Text="Светлая тема:" VerticalAlignment="Center" Margin="5"/>
                        <Border Width="100" Height="50" Background="White" BorderThickness="1" BorderBrush="Gray" Margin="5">
                            <Border BorderThickness="1" Margin="49,0,0,0" Background="#FF6A9FB5"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                        <!-- Карточка: Светлая -->
                        <Border Width="130" Height="80" Margin="0,0,14,0"
                                CornerRadius="10" Cursor="Hand"
                                BorderThickness="2.5"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFF4F4F8" Offset="0"/>
                                    <GradientStop Color="#FFFFFFFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Превью: светлые полосы -->
                                <Border Width="80" Height="28" CornerRadius="5" Background="#FFF0F0F4" Margin="0,0,0,6">
                                    <StackPanel Margin="6,4">
                                        <Border Height="4" CornerRadius="2" Background="#FFD0D0DC" Margin="0,0,0,3"/>
                                        <Border Height="4" CornerRadius="2" Background="#FF5A8FA8" Width="30" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton x:Name="RbLight" GroupName="AppTheme" Margin="0,0,4,0"/>
                                    <TextBlock Text="Светлая" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#333333" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Карточка: Тёмная -->
                        <Border Width="130" Height="80"
                                CornerRadius="10" Cursor="Hand"
                                BorderThickness="2.5"
                                BorderBrush="{DynamicResource AccentBrush}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF1E1E24" Offset="0"/>
                                    <GradientStop Color="#FF2C2C34" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Превью: тёмные полосы -->
                                <Border Width="80" Height="28" CornerRadius="5" Background="#FF222228" Margin="0,0,0,6">
                                    <StackPanel Margin="6,4">
                                        <Border Height="4" CornerRadius="2" Background="#FF404050" Margin="0,0,0,3"/>
                                        <Border Height="4" CornerRadius="2" Background="#FFB565C1" Width="30" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <RadioButton x:Name="RbDark" GroupName="AppTheme" Margin="0,0,4,0"/>
                                    <TextBlock Text="Тёмная" FontSize="11" FontWeight="SemiBold"
                                               Foreground="#DDDDDD" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button Content="Применить тему" Click="ConfirmTheme_Click"
                            Margin="0,0,0,4" Padding="14,7" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <!-- Accent color picker -->
            <GroupBox Header="Акцентный цвет" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Выберите акцентный цвет интерфейса:"
                               Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,0,0,10"/>
                    <WrapPanel x:Name="AccentColorPanel" Margin="0,0,0,10">
                        <!-- Filled dynamically from code -->
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="HEX:" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,6,0"/>
                        <TextBox x:Name="TbAccentHex" Width="90" Height="28"
                                 Padding="6,2" Text="#B565C1"
                                 ToolTip="Введите HEX-код цвета и нажмите Enter"
                                 KeyDown="TbAccentHex_KeyDown"/>
                        <Border x:Name="AccentPreview" Width="28" Height="28"
                                CornerRadius="6" Margin="6,0,0,0"
                                BorderBrush="{DynamicResource BorderMedBrush}" BorderThickness="1"/>
                        <Button Content="Применить" Click="ApplyAccentColor_Click"
                                Margin="6,0,0,0" Padding="10,4" MinHeight="0"/>
                        <Button Content="Сбросить" Click="ResetAccentColor_Click"
                                Margin="4,0,0,0" Padding="10,4" MinHeight="0"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="{DynamicResource LanguageBtn}" Margin="5" Padding="10">
                <StackPanel HorizontalAlignment="Center">
                    <ComboBox x:Name="LanguageComboBox" Width="200" SelectedValuePath="Tag">
                        <ComboBoxItem Tag="ru" Content="Русский"/>
                        <ComboBoxItem Tag="en" Content="English"/>
                        <ComboBoxItem Tag="jp" Content="日本語"/>
                    </ComboBox>
                    <Button Content="{DynamicResource SettingsBtn}" Click="ApplyLanguage_Click" Margin="5" Padding="10"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Автосохранение" Margin="5" Padding="10">
                <StackPanel>
                    <CheckBox x:Name="CbLoadLastOnStart" Content="Загружать последний используемый файл при запуске" Margin="0,0,0,10"/>
                    <CheckBox x:Name="CbEnableAutoSave" Content="Включить автосохранение" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Интервал (мин):" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="TbAutoSaveInterval" Width="60" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Папка сохранений:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="TbAutoSaveFolder" Width="200" IsReadOnly="True" Height="30"/>
                        <Button Content="..." Click="BrowseFolder_Click" Margin="5,0,0,0" Width="30" Height="30"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Шаблон имени файла:" VerticalAlignment="Center" Width="120"/>
                        <TextBox x:Name="TbAutoSavePattern" Width="200" Height="30"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- ══ Видимость встроенных страниц ══════════════════════════════ -->
            <GroupBox Header="Видимость страниц" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Скрыть ненужные страницы из бокового меню:"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <WrapPanel>
                        <CheckBox x:Name="CbShowMainPage"     Content="Главная"         IsChecked="True" Margin="6,4" Tag="MainPage"      Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowDetails"      Content="Предыстория"     IsChecked="True" Margin="6,4" Tag="Details"       Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowEquipment"    Content="Снаряжение"      IsChecked="True" Margin="6,4" Tag="Equipment"     Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowStats"        Content="Характеристики" IsChecked="True" Margin="6,4" Tag="Stats"         Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowActiveSkills" Content="Активные навыки" IsChecked="True" Margin="6,4" Tag="ActiveSkills"  Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowPassive"      Content="Пассивные навыки" IsChecked="True" Margin="6,4" Tag="PassiveSkills" Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowProf"         Content="Владения"        IsChecked="True" Margin="6,4" Tag="Proficiencies" Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                        <CheckBox x:Name="CbShowAttacks"      Content="Атаки"           IsChecked="True" Margin="6,4" Tag="Attacks"       Checked="PageVisibility_Changed" Unchecked="PageVisibility_Changed"/>
                    </WrapPanel>
                </StackPanel>
            </GroupBox>

            <!-- ══ Пользовательские листы ════════════════════════════════════ -->
            <GroupBox Header="Пользовательские листы" Margin="5" Padding="10">
                <StackPanel>
                    <TextBlock Text="Ваши страницы с произвольными колонками:"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,8"/>
                    <ListBox x:Name="LbCustomSheets" MinHeight="50" MaxHeight="100"
                             Margin="0,0,0,8"
                             Background="{DynamicResource SurfaceBrush}"
                             Foreground="{DynamicResource TextBrush}"
                             BorderBrush="{DynamicResource BorderBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="🔄 Обновить список" Click="RefreshSheetList_Click"
                                Margin="0,0,8,0" Padding="10,6" HorizontalAlignment="Left"/>
                        <Button Content="Удалить выбранный" Click="RemoveSheet_Click"
                                Padding="10,6" HorizontalAlignment="Left"/>
                    </StackPanel>
                    <Separator Margin="0,0,0,10"/>
                    <TextBlock Text="Создать новый лист:" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Название:" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBox x:Name="TbSheetName" Grid.Column="1" Padding="6,4"/>
                    </Grid>
                    <TextBlock Text="Колонки — одна на строку, формат: Название:тип"
                               Foreground="{DynamicResource TextBrush}" Margin="0,0,0,2"/>
                    <TextBlock Text="Типы: text, number, toggle"
                               FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="TbSheetColumns" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="70" Padding="6,4" VerticalScrollBarVisibility="Auto"/>
                    <Button Content="Добавить лист" Click="AddSheet_Click"
                            Margin="0,8,0,0" Padding="12,7" HorizontalAlignment="Left"/>
                </StackPanel>
            </GroupBox>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="20,10,0,0">
            <Button Content="Сохранить" Click="SaveSettings_Click" Margin="20" Width="100" HorizontalAlignment="Center"/>
            <Button Content="Вернуться" Click="Back_Click" Margin="20" Width="100" HorizontalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>