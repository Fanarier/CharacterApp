<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:CharacterApp.Converters">

    <!-- Цвета и кисти -->
    <SolidColorBrush x:Key="CardBackground" Color="#0AFFFFFF"/>
    <SolidColorBrush x:Key="CardBorder" Color="#BABABA"/>
    <SolidColorBrush x:Key="SlotHighlight" Color="#FFB565C1"/>
    <SolidColorBrush x:Key="SlotLockedOverlay" Color="#66686868"/>

    <!-- Тень -->
    <DropShadowEffect x:Key="SubtleShadow" BlurRadius="4" ShadowDepth="1" Color="#44000000" Opacity="0.3"/>

    <!-- Стиль "карточки" для Border (без ControlTemplate — Border не поддерживает Template) -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Background" Value="{StaticResource CardBackground}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CardBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Effect" Value="{StaticResource SubtleShadow}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
    </Style>

    <!-- Лёгкие сториборды -->
    <Storyboard x:Key="SlotHoverShow">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.16"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.16"/>
    </Storyboard>
    <Storyboard x:Key="SlotHoverHide">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.0" Duration="0:0:0.16"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.0" Duration="0:0:0.16"/>
    </Storyboard>

    <!-- Конвертеры -->
    <!-- Стиль кнопки кубика в DiceRoller -->
    <Style x:Key="DiceButtonStyle" TargetType="Button">
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="Margin"          Value="2"/>
        <Setter Property="Background"      Value="#20B565C1"/>
        <Setter Property="Foreground"      Value="{DynamicResource AccentLightBrush}"/>
        <Setter Property="BorderBrush"     Value="#35B565C1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontSize"        Value="11.5"/>
        <Setter Property="FontFamily"      Value="Segoe UI Semibold"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Height"          Value="26"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="5" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#35B565C1"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#70B565C1"/>
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.88" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.88" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Bd"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <conv:RatingIconMultiConverter x:Key="RatingIconMultiConverter"/>

    <!-- Компактная кнопка с иконкой (для слотов экипировки) -->
    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Width"           Value="34"/>
        <Setter Property="Height"          Value="28"/>
        <Setter Property="Margin"          Value="2"/>
        <Setter Property="Padding"         Value="0"/>
        <Setter Property="MinHeight"       Value="0"/>
        <Setter Property="Background"      Value="{DynamicResource AccentGradientV}"/>
        <Setter Property="Foreground"      Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="FontSize"        Value="14"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.08" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.08" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.18"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0.93" Duration="0:0:0.07"/>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0.93" Duration="0:0:0.07"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="Root"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.12"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <conv:NullOrEmptyToVisibilityConverter x:Key="NullOrEmptyToVisibilityConverter"/>


    <Style TargetType="DataGrid" x:Key="SkillsGridStyle">
            <!-- Рамка была акцентной — таблица кричала громче своего содержимого.
                 Вертикальные линии убраны: колонки и так разделены отступами,
                 сетка добавляла шума -->
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,1,0,1"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
            <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <!-- Именно МИНИМАЛЬНАЯ высота, а не фиксированная. С RowHeight="34"
                 многострочные описания не помещались в строку и обрезались
                 по середине текста — на экране получалась каша из обрывков -->
            <Setter Property="MinRowHeight" Value="34"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>


    <Style TargetType="DataGridRow" x:Key="SkillsRowStyle">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavHoverBgBrush}"/>
                </Trigger>
                <!-- Выделение больше не заливает строку акцентом целиком:
                     от полосы поперёк экрана рябило, а текст на ней терялся -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource NavActiveBgBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsSelected" Value="True"/>
                        <Condition Property="IsKeyboardFocusWithin" Value="False"/>
                    </MultiTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource AccentDimBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                </MultiTrigger>
            </Style.Triggers>
        </Style>


    <Style TargetType="TextBox" x:Key="CellTextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>


    <ControlTemplate x:Key="StatusToggleTemplate" TargetType="ToggleButton">
            <Border Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
              <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Ellipse x:Name="Circle" StrokeThickness="3" Fill="Transparent"
                         Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                         Visibility="Collapsed"/>
                <Path x:Name="Cross" Data="M8,8 L24,24 M24,8 L8,24"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=DataGridRow}}"
                      StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Circle" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Cross" Property="Visibility" Value="Collapsed"/>
                </Trigger>
                <Trigger Property="IsChecked" Value="False">
                    <Setter TargetName="Circle" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Cross" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Circle" Property="Opacity" Value="0.3"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

    <!-- Иконки пунктов меню. Геометрия, а не картинки: красится темой -->
    <PathGeometry x:Key="IcoHome" Figures="M12 3 3 10v10h6v-6h6v6h6V10z"/>
    <PathGeometry x:Key="IcoBook" Figures="M12 12a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M4 21c0-4 3.6-6.5 8-6.5s8 2.5 8 6.5"/>
    <PathGeometry x:Key="IcoShield" Figures="M12 2 4 5v7c0 5 3.5 8.5 8 10 4.5-1.5 8-5 8-10V5z"/>
    <PathGeometry x:Key="IcoBag" Figures="M6 8h12l1 12H5z M9 8V6a3 3 0 0 1 6 0v2"/>
    <PathGeometry x:Key="IcoChart" Figures="M4 20V10h4v10z M10 20V4h4v16z M16 20v-7h4v7z"/>
    <PathGeometry x:Key="IcoBolt" Figures="M13 2 4 14h6l-1 8 9-12h-6z"/>
    <PathGeometry x:Key="IcoStar" Figures="M12 3l2.6 5.6 6 .8-4.4 4.2 1.1 6.1-5.3-3-5.3 3 1.1-6.1L3.4 9.4l6-.8z"/>
    <PathGeometry x:Key="IcoBadge" Figures="M12 2 4 6v6c0 4.5 3.4 8.5 8 10 4.6-1.5 8-5.5 8-10V6z M9 12l2.2 2.2L15.5 10"/>
    <PathGeometry x:Key="IcoSword" Figures="M14 3h7v7l-9 9-2-2-3 3-3-3 3-3-2-2z M5 19l2 2"/>
    <PathGeometry x:Key="IcoNote" Figures="M6 3h9l4 4v14H6z M15 3v4h4 M9 12h7 M9 16h7"/>
    <PathGeometry x:Key="IcoBell" Figures="M12 3a5 5 0 0 0-5 5v4l-2 3h14l-2-3V8a5 5 0 0 0-5-5z M10 18a2 2 0 0 0 4 0"/>
    <PathGeometry x:Key="IcoDice" Figures="M12 2 3 7v10l9 5 9-5V7z M12 12 3 7 M12 12l9-5 M12 12v10"/>
    <PathGeometry x:Key="IcoGear" Figures="M12 8a4 4 0 1 0 0 8 4 4 0 0 0 0-8z M12 2v3 M12 19v3 M2 12h3 M19 12h3 M5 5l2 2 M17 17l2 2 M19 5l-2 2 M7 17l-2 2"/>
    <PathGeometry x:Key="IcoIdCard" Figures="M3 5h18v14H3z M9 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4z M6 16c0-1.7 1.3-3 3-3s3 1.3 3 3 M14 9h4 M14 13h4"/>
    <PathGeometry x:Key="IcoTable" Figures="M3 5h18v14H3z M3 10h18 M9 10v9 M15 10v9"/>

</ResourceDictionary>
